{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rent-manager",
  "compatibility_date": "2026-07-23",
  "main": "./src/worker.mjs",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}