{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rent-manager",
  "compatibility_date": "2026-07-23",
  "main": "./src/worker.mjs",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "FORM_ALLOWED_ORIGIN": "https://cert.muchengtech.com,https://rent-cert.muchengtech.com",
    "FORM_SENDER": "certissuereport@muchengtech.com",
    "REPORT_MAIL": "certissuereport@muchengtech.com"
  },

  "send_email": [
    {
      "name": "REPORT_EMAIL",
      "destination_address": "certissuereport@muchengtech.com"
    }
  ],

  "observability": {
    "enabled": true
  }
}
