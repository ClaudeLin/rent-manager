{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rent-manager",
  "compatibility_date": "2026-07-23",
  "main": "./src/worker.mjs",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}