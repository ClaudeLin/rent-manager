---
import '../styles/app.css'
import OfflineNotice from '../components/OfflineNotice.astro'
import ReportDialog from '../components/ReportDialog.astro'
import SeoMeta from '../components/SeoMeta.astro'
import SiteFooter from '../components/SiteFooter.astro'
const title = '租賃住宅管理人員題庫練習｜初訓與換證'
const description = '租賃住宅管理人員初訓與換證題庫的個人學習及練習工具。'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '租賃住宅管理人員題庫練習',
  url: new URL('/', Astro.site).href,
  inLanguage: 'zh-Hant-TW',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: '沐承科技有限公司',
    url: 'https://muchengtech.com',
  },
}
---
<!doctype html><html lang="zh-Hant-TW"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#143b63"/><SeoMeta title={title} description={description} canonicalPath="/"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="manifest" href="/manifest.webmanifest"/><script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline /></head><body><main class="single-column"><section class="question-bank-choice"><p class="eyebrow">Rental Housing Manager</p><h1>選擇練習題庫</h1><p>請先選擇要準備的訓練類型。作答資料只保存在此裝置，初訓與換證紀錄互相獨立。</p><div class="question-bank-actions track-choice-actions"><a class="button track-init-button" href="/init/">初訓題庫</a><a class="button track-renew-button" href="/renew/">換證題庫</a></div><aside class="question-bank-source"><h2>使用說明</h2><p>本工具僅供學習與練習使用，題目內容請以官方最新公告為準。</p><p><a href="/about/">查看資料來源、使用說明與免責聲明</a>，或 <button type="button" class="text-button" data-report-open>回報問題</button>。</p></aside></section></main><SiteFooter /><ReportDialog /><OfflineNotice /></body></html>
