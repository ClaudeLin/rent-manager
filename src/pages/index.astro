---
import '../styles/app.css'
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#143b63" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    />
    <meta
      name="apple-mobile-web-app-title"
      content="租賃題庫"
    />
    <title>租賃住宅管理人員題庫</title>
  </head>
  <body>
    <main id="app" aria-live="polite"></main>
    <script>
      import { clearStoredSession, readStoredSession, sessionSummary } from '../lib/session'

      const root = document.querySelector<HTMLElement>('#app')!
      const practicePath = '/practice/'
      const bankStorageKey = 'rent-exam-question-bank-v1'
      const bankLabels = { withLaw: '有詳解題庫', withoutLaw: '只有答案題庫' } as const
      const escapeHtml = (value: string): string => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]!)

      const saveQuestionBank = (bankKey: string): void => {
        try {
          localStorage.setItem(bankStorageKey, bankKey)
        } catch {
          // 部分受限制的瀏覽環境可能無法使用 localStorage。
          // 保留 sessionStorage 作為降級方案。
          try {
            sessionStorage.setItem(bankStorageKey, bankKey)
          } catch {
            // 儲存空間完全不可用時，功能頁會回到入口。
          }
        }
      }
      const renderChoice = () => {
        const stored = readStoredSession()
        const resume = stored ? sessionSummary(stored) : null
        const resumeMarkup = resume ? `<section class="resume-card" aria-labelledby="resume-heading"><p class="eyebrow">上次進度</p><h2 id="resume-heading">繼續上次練習</h2><p><strong>${escapeHtml(resume.title)}</strong>・${escapeHtml(resume.progress)}</p><p class="resume-bank">題庫：${escapeHtml(bankLabels[resume.bankKey])}</p><div class="action-group"><button type="button" class="button" data-action="continue-session">繼續上次練習</button><button type="button" class="button secondary-button" data-action="discard-session">放棄這次進度</button></div></section>` : ''
        root.innerHTML = `<section class="question-bank-choice" aria-labelledby="question-bank-heading"><p class="eyebrow">租賃住宅管理人員題庫</p><h1 id="question-bank-heading">選擇題庫</h1>${resumeMarkup}<p>請選擇要使用的題庫版本。選擇題庫會開始一輪新的練習；之後可隨時由頁首返回更換。</p><div class="question-bank-actions"><button type="button" class="button" data-question-bank="withLaw">有詳解題庫</button><button type="button" class="button secondary-button" data-question-bank="withoutLaw">只有答案題庫</button></div><aside class="question-bank-source" aria-labelledby="question-bank-source-heading"><h2 id="question-bank-source-heading">題庫來源與使用說明</h2><p>題庫取自<a href="https://rentalh.org.tw/down-list2.php?lmenuid=12&mpmid=2" target="_blank" rel="noopener noreferrer">中華民國租賃住宅服務商業同業公會全國聯合會</a>公布的「租賃住宅管理人員資格訓練題庫(全科目不含法源依據)115.02.06更新版」與「租賃住宅管理人員資格訓練題庫(全科目含法源依據)115.02.06更新版」。</p><p class="question-bank-updated">題庫最後更新／轉檔日期：<time datetime="2026-07-21">2026/7/21</time></p><p class="question-bank-disclaimer">本題庫僅供學習與練習使用，內容請以官方最新公告為準。</p><a class="question-bank-about" href="/about/">查看完整資料來源、模擬考規則與免責聲明</a></aside></section><aside class="offline-toast" data-offline-notice data-state="preparing" role="status" aria-live="polite" aria-atomic="true" hidden><span class="offline-toast-icon" data-offline-icon aria-hidden="true"></span><span class="offline-toast-message" data-offline-message></span><button type="button" class="offline-toast-dismiss" data-dismiss-offline aria-label="關閉離線狀態提示">×</button><span class="offline-toast-progress" aria-hidden="true"></span></aside>`
        root.querySelectorAll<HTMLButtonElement>('[data-question-bank]').forEach((button) => {
          button.addEventListener('click', () => {
            clearStoredSession()
            saveQuestionBank(button.dataset.questionBank!)
            window.location.assign(practicePath)
          })
        })
        root.querySelector<HTMLButtonElement>('[data-action="continue-session"]')?.addEventListener('click', () => {
          if (!resume) return
          saveQuestionBank(resume.bankKey)
          window.location.assign(resume.route)
        })
        root.querySelector<HTMLButtonElement>('[data-action="discard-session"]')?.addEventListener('click', (event) => {
          clearStoredSession()
          ;(event.currentTarget as HTMLElement).closest('.resume-card')?.remove()
        })
      }
      renderChoice()
    </script>
<script>
  import { showOfflineNotice } from '../lib/offline-notice'
  import { registerServiceWorker } from '../lib/pwa'

  const offlineNotice =
    document.querySelector<HTMLElement>('[data-offline-notice]')

  void registerServiceWorker().then((status) => {
    if (offlineNotice && status !== 'existing') showOfflineNotice(offlineNotice, status)
  })
</script>
  </body>
</html>
