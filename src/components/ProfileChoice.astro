---
import '../styles/app.css'
import { getExamProfile, routesForProfile } from '../lib/exam-profiles'
const { track } = Astro.props
const profile = getExamProfile(track)
const routes = routesForProfile(profile)
---
<!doctype html><html lang="zh-Hant-TW"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#143b63" /><link rel="manifest" href="/manifest.webmanifest" /><title>{profile.label}題庫｜租賃住宅管理人員題庫</title></head><body><main class="single-column"><section class="question-bank-choice"><p class="eyebrow">{profile.label}題庫</p><h1>選擇題庫版本</h1><p>選擇有詳解或只有答案的版本後，開始練習。作答紀錄只保存在此裝置。</p><div class="question-bank-actions"><button type="button" class="button" data-bank="withLaw">有詳解題庫</button><button type="button" class="button secondary-button" data-bank="withoutLaw">只有答案題庫</button></div><aside class="question-bank-source"><h2>資料來源</h2><p>{profile.source.title}；資料版本日期：<time datetime={profile.source.updatedAt}>{profile.source.updatedAt}</time>。</p><a href={routes.about}>查看完整資料來源與使用說明</a></aside></section></main><script is:inline define:vars={{ storageKey: profile.storage.selectedBank, practicePath: routes.practice }}>document.querySelectorAll('[data-bank]').forEach((button) => button.addEventListener('click', () => { try { localStorage.setItem(storageKey, button.dataset.bank) } catch {} window.location.assign(practicePath) }))</script><script>import { registerServiceWorker } from '../lib/pwa'; void registerServiceWorker()</script></body></html>
