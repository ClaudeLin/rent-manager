---
import '../styles/app.css'
import ReportDialog from './ReportDialog.astro'
import { getExamProfile, routesForProfile } from '../lib/exam-profiles'
const { track } = Astro.props
const profile = getExamProfile(track)
const routes = routesForProfile(profile)
const canonical = new URL(`${profile.basePath}/`, Astro.site)
---
<!doctype html><html lang="zh-Hant-TW"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content={profile.theme.color} /><meta name="description" content={`租賃住宅管理人員${profile.label}題庫的個人學習與練習工具。`} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="canonical" href={canonical} /><link rel="manifest" href={profile.theme.manifestPath} /><title>{profile.label}題庫｜租賃住宅管理人員題庫</title></head><body data-track={profile.key}><main class="single-column" data-profile-choice data-storage-key={profile.storage.selectedBank} data-session-key={profile.storage.session} data-base-path={profile.basePath}><section class="question-bank-choice"><p class="eyebrow">{profile.label}題庫</p><h1>選擇題庫版本</h1><p>選擇有詳解或只有答案的版本後，開始練習。作答紀錄只保存在此裝置，並與另一訓練類型分開。</p><div class="question-bank-actions variant-choice-actions"><button type="button" class="button" data-bank="withLaw">有詳解題庫</button><button type="button" class="button" data-bank="withoutLaw">只有答案題庫</button></div><a class="track-switch-link" href="/">切換初訓／換證</a><section data-session-resume hidden aria-live="polite"></section><aside class="question-bank-source"><h2>資料來源</h2><p>{profile.source.title}</p><p>官方更新日期：<time datetime={profile.source.officialUpdatedAt}>{profile.source.officialUpdatedAt}</time><br />本站最後更新／轉檔日期：<time datetime={profile.source.siteUpdatedAt}>{profile.source.siteUpdatedAt}</time></p><p>本題庫僅供學習與練習使用，內容請以官方最新公告為準。</p><p><a href={routes.about}>查看完整資料來源與使用說明</a>，或 <button type="button" class="text-button" data-report-open data-report-track={profile.key}>回報問題</button>。</p></aside></section></main><ReportDialog /><aside class="offline-toast" data-offline-notice hidden aria-live="polite"><span data-offline-icon></span><span data-offline-message></span><button type="button" data-dismiss-offline aria-label="關閉">×</button><i class="offline-toast-progress"></i></aside><script>import { clearStoredSession, readStoredSession, sessionSummary } from '../lib/session'; import { storeSelectedBank } from '../lib/selected-bank'; import { initOfflineNotice } from '../lib/offline-notice'; const root = document.querySelector<HTMLElement>('[data-profile-choice]')!; const storageKey = root.dataset.storageKey!; const sessionKey = root.dataset.sessionKey!; const basePath = root.dataset.basePath!; document.querySelectorAll<HTMLButtonElement>('[data-bank]').forEach((button) => button.addEventListener('click', () => { storeSelectedBank(storageKey, button.dataset.bank as 'withLaw' | 'withoutLaw'); window.location.assign(`${basePath}/practice/`) })); const resume = root.querySelector<HTMLElement>('[data-session-resume]')!; const session = readStoredSession(sessionKey); if (session) { const summary = sessionSummary(session, basePath); resume.hidden = false; resume.innerHTML = `<h2>繼續上次練習</h2><p>${summary.title}・${summary.progress}</p><div class="question-bank-actions"><a class="button" href="${summary.route}">繼續上次練習</a><button type="button" class="button destructive-outline-button" data-discard-session>放棄這次進度</button></div>`; resume.querySelector<HTMLButtonElement>('[data-discard-session]')?.addEventListener('click', () => { clearStoredSession(sessionKey); resume.hidden = true }) } initOfflineNotice()</script></body></html>
