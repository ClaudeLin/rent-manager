---
interface Props {
  title: string
  description: string
  canonicalPath: string
  indexable?: boolean
}

const {
  title,
  description,
  canonicalPath,
  indexable = true,
} = Astro.props
const canonical = new URL(canonicalPath, Astro.site)
const image = new URL('/og-image.png', Astro.site)
const robots = indexable
  ? 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
  : 'noindex,follow'
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="zh_TW" />
<meta property="og:site_name" content="租賃住宅管理人員題庫練習" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="租賃住宅管理人員初訓與換證題庫練習工具" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="租賃住宅管理人員初訓與換證題庫練習工具" />
