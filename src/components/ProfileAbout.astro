---
import '../styles/app.css'
import { getExamProfile, routesForProfile } from '../lib/exam-profiles'
const { track } = Astro.props
const profile = getExamProfile(track); const routes = routesForProfile(profile)
---
<!doctype html><html lang="zh-Hant-TW"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="manifest" href="/manifest.webmanifest"/><title>關於題庫</title></head><body><header class="brand"><a class="brand-home" href={routes.home}>租賃住宅管理人員證照題庫練習</a><nav class="primary-nav"><a href={routes.practice}>全題練習</a><a href={routes.chapter}>章節練習</a>{profile.mockExam.enabled && <a href={routes.mock}>模擬考</a>}<a href={routes.wrong}>錯題回顧</a></nav></header><main class="single-column about-page"><section class="card"><h1>關於{profile.label}題庫</h1><p>本站提供全題、章節與錯題回顧，協助個人學習與自我測驗。紀錄僅保存在此瀏覽器，初訓與換證資料完全分開。</p></section><section class="card"><h2>資料來源</h2><p>{profile.source.title}，資料版本日期：{profile.source.updatedAt}。內容請以官方最新公告為準。</p></section>{profile.mockExam.enabled && <section class="card"><h2>模擬考規則</h2><p>初訓從十章各抽十題，共 100 題，作答時間 120 分鐘。</p></section>}<section class="card"><h2>免責聲明</h2><p>本網站僅供個人學習，不代表主管機關或考試主辦單位，亦非法律意見。</p></section></main><script>import { registerServiceWorker } from '../lib/pwa'; void registerServiceWorker()</script></body></html>
