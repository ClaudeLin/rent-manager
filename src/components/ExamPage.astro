---
import '../styles/app.css'
import OfflineNotice from './OfflineNotice.astro'
import { getExamProfile, routesForProfile } from '../lib/exam-profiles'
const { track, view = 'practice' } = Astro.props
const profile = getExamProfile(track)
const routes = routesForProfile(profile)
const canonicalPath = ({ practice: routes.practice, chapter: routes.chapter, mock: routes.mock, wrong: routes.wrong } as Record<string, string>)[view] ?? routes.practice
const canonical = new URL(canonicalPath, Astro.site)
---
<!doctype html><html lang="zh-Hant-TW"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content={profile.theme.color} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="canonical" href={canonical} /><link rel="manifest" href={profile.theme.manifestPath} /><title>租賃住宅管理人員題庫</title></head><body data-track={track}><main id="app" data-track={track} data-view={view} aria-live="polite"></main><OfflineNotice /><script>import { bootstrapExamPage } from '../lib/bootstrap'; const root = document.querySelector<HTMLElement>('#app')!; void bootstrapExamPage(root, root.dataset.track as 'init' | 'renew', root.dataset.view as 'practice' | 'chapter' | 'mock' | 'wrong')</script></body></html>
